type Currency {
    id: ID!
    code: String!
    name: String!
    symbol: String!
}

type User {
    id: ID!
    name: String!
    token: String!
}

type RedactedGroup {
    name: String!
    members: [User!]!
}

type Group {
    id: ID!
    name: String!
    inviteToken: String!
    members: [User!]!
    usedCurrencies: [Currency!]!
}

type ExpenseSummary {
    expenses: [Expense!]!
    owes: [Owe!]!
    owed: [Owe!]!
}

type Owe {
    user: User!
    amount: Decimal!
    currency: Currency!
}

type ConversionDetails {
    sourceCurrency: Currency!
    sourceAmount: Decimal!
    rate: Decimal!
}

type ExchangeRate {
    code: String!
    rate: Decimal!
}

type ExchangeRateSnapshot {
    base: String!
    rates: [ExchangeRate!]!
    fetchedAt: Time!
    unsupportedCurrencies: [String!]!
}

type Expense {
    id: ID!
    type: String!
    name: String!
    description: String!
    amount: Decimal!
    currency: Currency!
    expenseAt: Time!
    payers: [Share!]!
    shares: [Share!]!
    conversionDetails: ConversionDetails
}

type Share {
    user: User!
    amount: Decimal!
}